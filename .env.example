# Kopieren nach .env und Werte eintragen ( .env wird nicht committed )

OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=49

# Wiki-Waechter E-Mail-Bericht (optional)
EMAIL_ABSENDER=ihre-adresse@example.com
EMAIL_PASSWORT=app-passwort-oder-smtp-passwort
EMAIL_EMPFAENGER=empfaenger@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
# Port 465: SSL automatisch; erzwingen mit SMTP_USE_SSL=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT=45

APOLLO_API_KEY=
